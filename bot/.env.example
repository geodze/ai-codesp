# ---- minimum required ---------------------------------------------------

# Telegram bot token from @BotFather. Only mandatory secret — everything
# else (LLM provider, API key, model, custom URL) is configured via the
# /start onboarding wizard inside Telegram once the bot is up.
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- runtime mode -------------------------------------------------------

# 'polling' works on every cloud out-of-the-box (Render, Railway, Fly,
# Heroku, VPS). 'webhook' is faster but requires PUBLIC_URL.
BOT_MODE=polling

# Required only for webhook mode. Render assigns this automatically as
# https://<service-name>.onrender.com — copy it here and switch BOT_MODE.
PUBLIC_URL=

# Where to persist state.json (owner, keys, model, brain) and cloned
# projects. Use a path on a persistent volume in production, /tmp is fine
# for ephemeral platforms.
DATA_DIR=/tmp/bot-data

# ---- self-ping (keeps Render Free awake) -------------------------------

# Render Free spins down web services after 15 minutes of *incoming* HTTP
# inactivity. The bot's outgoing Telegram polling doesn't qualify, so we
# self-ping our own /healthz periodically to keep the idle timer reset.
# URL is auto-detected on Render (RENDER_EXTERNAL_URL), Railway
# (RAILWAY_PUBLIC_DOMAIN) and Fly (FLY_APP_NAME). Override for VPS /
# custom setups:
# KEEP_ALIVE_URL=https://your-service.example.com

# By default the loop picks a random delay in [MIN, MAX] seconds, biased
# toward MAX so the pings don't look like a fixed cron tick. Defaults
# below ping every 4-7 minutes (well under Render's 15-min limit).
KEEP_ALIVE_MIN_SECONDS=240
KEEP_ALIVE_MAX_SECONDS=420
KEEP_ALIVE_BIAS=0.8

# Optional override: leave KEEP_ALIVE_INTERVAL unset (default) for the
# random behavior above. Set to a positive integer for a fixed interval
# in seconds. Set to 0 to disable self-pinging entirely (Fly always-on,
# your own VPS, etc.).
# KEEP_ALIVE_INTERVAL=

# ---- optional / advanced ------------------------------------------------

# OpenRouter API key. Optional at startup — set it from Telegram via
# /start → 🧠 OpenRouter → 🔑 API ключ. Env-var here is just a fallback
# for self-hosters who prefer Docker-only configuration.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Comma-separated list of Telegram user ids allowed to use the bot.
# Optional now — the first user who taps /start → "Запустить" becomes
# the locked-in owner. Setting this still works as a fallback (lets you
# pre-authorize a user before they ever message the bot).
# Get yours: https://t.me/userinfobot
ALLOWED_USER_IDS=

# Default model used when /setup → OpenRouter without picking a model.
MODEL=nvidia/nemotron-3-super-120b-a12b:free
FALLBACK_MODELS=openai/gpt-oss-120b:free,qwen/qwen3-coder:free,minimax/minimax-m2.5:free

# Tunables
EXEC_TIMEOUT=30
MAX_FILE_BYTES=200000
HISTORY_LIMIT=20
AGENT_MAX_STEPS=8
