# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API key (https://openrouter.ai/keys). Optional at startup —
# you can also set it from Telegram via /setkey openrouter sk-or-...
OPENROUTER_API_KEY=
# Optional: direct provider keys. Currently the bot routes through OpenRouter
# only; these are reserved for future direct routing and surface in /keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Comma-separated list of Telegram user ids that are allowed to use the bot
# Get yours from https://t.me/userinfobot
ALLOWED_USER_IDS=

# 'polling' for local dev, 'webhook' for Render/production
BOT_MODE=polling

# Required only for webhook mode (Render assigns this automatically as
# https://<service-name>.onrender.com)
PUBLIC_URL=

# Default model and fallbacks
MODEL=nvidia/nemotron-3-super-120b-a12b:free
FALLBACK_MODELS=openai/gpt-oss-120b:free,qwen/qwen3-coder:free,minimax/minimax-m2.5:free

# Where to store cloned projects (Render Free disk is ephemeral)
DATA_DIR=/tmp/bot-data

# Optional tunables
EXEC_TIMEOUT=30
MAX_FILE_BYTES=200000
HISTORY_LIMIT=20
AGENT_MAX_STEPS=8
